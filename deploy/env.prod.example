# /srv/golvfabriken/prod/.env  — never commit. Owned by deploy user, mode 600.
# All values populated by the deploy workflow from GitHub Actions secrets.

# --- Images (set by deploy workflow each run) ---
MEDUSA_IMAGE=ghcr.io/johanoloflindberg/golvfabriken-medusa:main
STRAPI_IMAGE=ghcr.io/johanoloflindberg/golvfabriken-strapi:main
STOREFRONT_IMAGE=ghcr.io/johanoloflindberg/golvfabriken-storefront:main

# --- Postgres ---
POSTGRES_USER=golvfabriken
POSTGRES_PASSWORD=

# --- Medusa ---
DATABASE_URL=postgres://golvfabriken:PASSWORD_HERE@postgres:5432/medusa_db
REDIS_URL=redis://redis:6379
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_BACKEND_URL=https://api.golvfabriken.se
STORE_CORS=https://golvfabriken.se,https://www.golvfabriken.se
ADMIN_CORS=https://admin.golvfabriken.se
AUTH_CORS=https://golvfabriken.se,https://admin.golvfabriken.se
STRIPE_API_KEY=sk_test_placeholder

# --- Strapi ---
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_USER_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_API_TOKEN=
STRAPI_WEBHOOK_SECRET=

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=golvfabriken-production
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.golvfabriken.se

# --- Storefront (build-time Vite vars, also injected to runtime) ---
VITE_MEDUSA_BACKEND_URL=https://api.golvfabriken.se
VITE_MEDUSA_PUBLISHABLE_KEY=
